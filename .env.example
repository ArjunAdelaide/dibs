# Free model: create a key at https://aistudio.google.com/apikey (no card needed).
# Free-tier prompts may be used by Google to improve its products: tell testers, and don't send anything sensitive.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-flash-lite-latest
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash

DIBS_CITY=Adelaide
DIBS_TZ=Australia/Adelaide
# Place names ("Norwood") are looked up inside this region.
DIBS_REGION=South Australia, Australia
# How often each alert is checked.
ALERT_INTERVAL_MINUTES=30

# iMessage bridge. Only these handles get replies (phone numbers in +61 format, or Apple ID emails).
# ALLOWLIST=* lets anyone text the agent (rate limits and STOP still apply).
ALLOWLIST=
# Your own number: concierge alerts land here.
OPERATOR_HANDLE=
# 1 = print replies instead of sending. Set to 0 only once the CLI works.
DRY_RUN=1
# In group chats the bot only answers messages containing this word.
GROUP_TRIGGER=dibs

# Optional email route, for venues where you pay on arrival and book by email.
# Use a free Gmail account made for the bot, with an app password. Replies go to BOOKING_REPLY_TO.
SMTP_USER=
SMTP_PASSWORD=
BOOKING_REPLY_TO=

# Optional: concerts and sport from Ticketmaster. Free key at developer.ticketmaster.com.
# Without it, event search uses the hand-kept calendar in data/events.json only.
TICKETMASTER_API_KEY=

# Optional payments. Use a Stripe TEST key (sk_test_...) from dashboard.stripe.com/test/apikeys.
# A live key is refused unless PAYMENTS_LIVE=1.
PAYMENTS_ENABLED=0
STRIPE_SECRET_KEY=

# Phase A: open a browser window on this Mac with each paid booking prepared, for you to check and pay.
SUPERVISED_CHECKOUT=1
# The email address given to venues on bookings.
BOOKING_EMAIL=
